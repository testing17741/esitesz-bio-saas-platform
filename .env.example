# Server & App Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_production
COOKIE_NAME=esitesz_session

# Super Admin Initial Credentials (used for initial seed if not already in DB)
SUPER_ADMIN_EMAIL=admin@esitesz.com
SUPER_ADMIN_PASSWORD=Admin@Esitesz2026!
SUPER_ADMIN_NAME="Esitesz Master Admin"

# Mail / OTP Configuration
# Set to 'console' for local dev (OTP is logged & displayed in UI preview mode), or 'smtp' for real emails
EMAIL_PROVIDER=console
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your-smtp-password
SMTP_FROM="eSitesz Bio <noreply@esitesz.com>"

# Analytics & Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
